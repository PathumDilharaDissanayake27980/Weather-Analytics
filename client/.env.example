# Where the Spring Boot API is listening
VITE_API_URL=http://localhost:8081

# Auth0. Omit these to run unauthenticated against a permissive-mode server
# (the dashboard shows a warning banner in that state).
# None of these are secrets - a browser bundle cannot keep one.
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=https://weather-analytics-api
